// Provider logos: single-colour SVGs (simple-icons, CC0; see README.md)
// embedded at build time and tinted with `colorize`. Providers without a
// licensed glyph get their initial instead.

import { Theme } from "../theme.slint";

export enum Logo { none, claude, openai, cursor, copilot, openrouter }

// Each provider's own colour in the rail. A near-black brand (Cursor) uses
// the text colour so it stays visible in both themes.
export global Brand {
    public pure function tint(l: Logo) -> color {
        if l == Logo.claude { return Theme.brand-claude; }
        if l == Logo.openai { return Theme.brand-codex; }
        if l == Logo.copilot { return Theme.brand-copilot; }
        if l == Logo.openrouter { return Theme.brand-openrouter; }
        return Theme.text;
    }
}

export component LogoGlyph inherits Rectangle {
    in property <Logo> logo;
    in property <string> initial;
    in property <length> size: Theme.icon;
    in property <color> tint: Theme.text;
    width: self.size;
    height: self.size;

    property <image> source: root.logo == Logo.claude ? @image-url("../icons/claude.svg")
        : root.logo == Logo.openai ? @image-url("../icons/openai.svg")
        : root.logo == Logo.cursor ? @image-url("../icons/cursor.svg")
        : root.logo == Logo.copilot ? @image-url("../icons/githubcopilot.svg")
        : root.logo == Logo.openrouter ? @image-url("../icons/openrouter.svg")
        : @image-url("");

    if root.logo != Logo.none: Image {
        width: 100%;
        height: 100%;
        source: root.source;
        colorize: root.tint;
        accessible-role: none;
    }
    if root.logo == Logo.none: Text {
        width: 100%;
        height: 100%;
        text: root.initial;
        color: root.tint;
        font-family: Theme.font-family;
        font-size: root.size * 0.75;
        font-weight: Theme.weight-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
}
